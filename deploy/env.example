# Copy to /srv/loveapp/.env and fill in. Then: chmod 600 /srv/loveapp/.env
# Loaded by systemd (EnvironmentFile), so do not put `export` in front.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Absolute path, outside the git checkout (four slashes = sqlite:/// + /srv/...)
SQLALCHEMY_DATABASE_URI=sqlite:////srv/loveapp/data/LoveApp.db

# Optional: real email notifications via Gmail app password
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=""
